# Build outputs
build/
cmake-build/
*.o
*.a
*.exe

# Runtime state: the simulator's own database and its lock
var/
*.db
*.db-wal
*.db-shm
*.db.lock

# Test verdicts are regenerated by scripts/run_tests.sh on every run. The CSV
# is kept out of version control for the same reason: it is a result, not a
# source, and a stale one is worse than none.
test-artifacts/*.json
test-artifacts/*.csv
